{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist/demo/browser",
  "framework": "angular",
  "functions": {
    "api/index.js": {
      "memory": 1024,
      "maxDuration": 10
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.js" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
